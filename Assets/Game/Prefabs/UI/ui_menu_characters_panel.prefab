  m_Script: {fileID: 11500000, guid: a188e62e1e38460b0f91e87efc924420, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _root: {fileID: 2290000020}
  _name: {fileID: 2290000243}
  _description: {fileID: 2290000263}
  _counter: {fileID: 2290000283}
  _previous: {fileID: 2290000124}
  _next: {fileID: 2290000184}
  _back: {fileID: 2290000064}
  _characters:
  - Name: COWBOY
    AccentColor: {r: 0.90588236, g: 0.7294118, b: 0.44313726, a: 1}
    Description: "<color=#E7BA71>ORIGEM</color>\nL\xEDder dos des\xE9rticos, usa
      implantes cibern\xE9ticos para sobreviver em um mundo de sucata. Quer deixar
      a cidade para tr\xE1s e viver no deserto.\n\n<color=#E7BA71>COMBATE</color>\nRev\xF3lver
      de seis tiros, precis\xE3o e mobilidade. Seu rolamento atravessa amea\xE7as,
      evita dano e recupera parte da muni\xE7\xE3o."
    Visual: {fileID: 2290000340}
  - Name: IRRIGADOR
    AccentColor: {r: 0.48235294, g: 0.8156863, b: 0.9019608, a: 1}
    Description: "<color=#7BD0E6>ORIGEM</color>\nNerei lidera os irrigadores. Com
      uma m\xE1scara de respira\xE7\xE3o e um tanque de \xE1gua, pretende inundar
      a cidade e construir seu imp\xE9rio.\n\n<color=#7BD0E6>COMBATE</color>\nDispara
      pregos de gelo que ficam presos no cen\xE1rio. Recupera a muni\xE7\xE3o e usa
      os pregos para se reposicionar; sua habilidade os atrai de volta."
    Visual: {fileID: 2290000360}
  - Name: CLANK, FUMACEIRO
    AccentColor: {r: 0.76862746, g: 0.6392157, b: 0.93333334, a: 1}
    Description: "<color=#C4A3EE>ORIGEM</color>\nUma mineradora de ferramentas perigosas
      e um enorme martelo s\xF4nico. Quer transformar a cidade em uma megamina.\n\n<color=#C4A3EE>COMBATE</color>\nDispara
      min\xE9rios e se agacha para coletar mais muni\xE7\xE3o. O martelo empurra
      os advers\xE1rios e permite impulsos no ar."
    Visual: {fileID: 2290000380}
  - Name: REBELDE
    AccentColor: {r: 0.93333334, g: 0.4745098, b: 0.4745098, a: 1}
    Description: "<color=#EE7979>ORIGEM</color>\nUm rob\xF4 avan\xE7ado que lidera
      os rebeldes. Luta para abolir a aristocracia e repartir os recursos da cidade.\n\n<color=#EE7979>COMBATE</color>\nUsa
      um taco met\xE1lico e uma bola que ricocheteia. Rebater a bola fortalece o
      disparo; a habilidade devolve amea\xE7as e afasta os inimigos."
    Visual: {fileID: 2290000400}
