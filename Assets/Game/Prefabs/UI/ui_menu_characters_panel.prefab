  _videoScreen: {fileID: 1450732512855672799}
  _videoPlayer: {fileID: 7820295964951443612}
  _characters:
  - Character: {fileID: 11400000, guid: c0400000000000000000000000000001, type: 2}
    Name: COWBOY
    AccentColor: {r: 0.90588236, g: 0.7294118, b: 0.44313726, a: 1}
    Story: "Membro dos Des\xE9rticos, cria animais nas terras \xE1ridas. Quer vencer
      o torneio e transformar a cidade em um dep\xF3sito de sucata."
    PortraitOffset: {x: 0, y: 0}
    Topics:
    - Heading: TIRO E RECARGA
      Description: "Cowboy possui 4 tiros que seguem em linha reta. Quando gasta todos os seus
        tiros, precisa esperar um tempo para recarregar sua arma e poder atirar
        novamente."
      Icon: {fileID: 0}
      Videos:
      - {fileID: 32900000, guid: a4fdc9d8555e1a94792cb7726aec8fca, type: 3}
    - Heading: HABILIDADE
      Description: "Cowboy realiza um dash durante o qual fica intang\xEDvel (atravessa
        jogadores e proj\xE9teis), n\xE3o recebe dano dos disparos e recupera 2
        muni\xE7\xF5es."
      Icon: {fileID: 21300000, guid: 27880f89e1859a04687b53dc3c27987f, type: 3}
      Videos:
      - {fileID: 32900000, guid: 74c3dede174f88b4ca53632ca6282fc0, type: 3}
  - Character: {fileID: 11400000, guid: c0400000000000000000000000000002, type: 2}
    Name: IRRIGADOR
    AccentColor: {r: 0.48235294, g: 0.8156863, b: 0.9019608, a: 1}
    Story: "O Irrigador lidera seu grupo, que abastece a cidade com \xE1gua. Quer
      vencer o torneio, inundar a cidade e erguer seu pr\xF3prio imp\xE9rio."
    PortraitOffset: {x: 0, y: 0}
    Topics:
    - Heading: TIRO
      Description: "Irrigador possui 2 pregos que dispara e que ficam presos nas superf\xEDcies
        que atingem."
      Icon: {fileID: 0}
      Videos:
      - {fileID: 32900000, guid: e1db9c677ec7f294887671561f45ea1f, type: 3}
    - Heading: PASSIVA E RECARGA
      Description: "Quando gasta todos os seus tiros, pode se puxar na dire\xE7\xE3o dos pregos
        apertando o mesmo bot\xE3o de atirar, recuperando 1 prego ao encostar nele."
      Icon: {fileID: 21300000, guid: 55c312014a4642a49f227d79d7a0ed4e, type: 3}
      Videos:
      - {fileID: 32900000, guid: 559231b2562eb2c4fa0d7eb0ec4685c8, type: 3}
    - Heading: HABILIDADE
      Description: "Irrigador usa um \xEDm\xE3 que puxa os pregos que estiverem na
        dire\xE7\xE3o para a qual sua mira aponta. Os pregos puxados podem causar
        dano."
      Icon: {fileID: 21300000, guid: c3ff0229dd78a4343b9c826fcb387cc3, type: 3}
      Videos:
      - {fileID: 32900000, guid: e1db9c677ec7f294887671561f45ea1f, type: 3}
  - Character: {fileID: 11400000, guid: c0400000000000000000000000000003, type: 2}
    Name: FUMACEIRA
    AccentColor: {r: 0.76862746, g: 0.6392157, b: 0.93333334, a: 1}
    Story: "A Fumaceira \xE9 uma mineradora do grupo dos Fumaceiros, respons\xE1vel
      pelo carv\xE3o e pela minera\xE7\xE3o. Ela quer vencer o torneio e transformar
      a cidade em uma grande mina."
    PortraitOffset: {x: 0, y: 0}
    Topics:
    - Heading: TIRO E RECARGA
      Description: "Fumaceira possui 4 min\xE9rios que dispara com seu martelo. Os min\xE9rios
        s\xE3o lan\xE7ados em linha reta. Ela pode miner\xE1-los novamente a
        qualquer momento, abaixando-se sobre qualquer superf\xEDcie, recuperando
        assim todos eles."
      Icon: {fileID: 0}
      Videos:
      - {fileID: 32900000, guid: b51908fb4691a964b92e30ed8c12ae65, type: 3}
    - Heading: HABILIDADE
      Description: "Fumaceira bate no ch\xE3o, saltando bem alto e arremessando os jogadores
        para longe."
      Icon: {fileID: 21300000, guid: 16fbb32c1b7d2794fb75cd46a4ca0f1b, type: 3}
      Videos:
      - {fileID: 32900000, guid: aca6cc1876cd8c049b84665f93cc13d3, type: 3}
  - Character: {fileID: 11400000, guid: c0400000000000000000000000000004, type: 2}
    Name: REBELDE
    AccentColor: {r: 0.93333334, g: 0.4745098, b: 0.4745098, a: 1}
    Story: "L\xEDder da Rebeli\xE3o, luta contra o dom\xEDnio dos aristocratas. Quer
      derrubar esse poder e unir os recursos da cidade em benef\xEDcio da popula\xE7\xE3o."
    PortraitOffset: {x: 0, y: 0}
    Topics:
    - Heading: "TIRO E RECUPERA\xC7\xC3O"
      Description: "Rebelde lan\xE7a uma bola como proj\xE9til, que quica nas paredes. A bola
        para depois de perder sua for\xE7a ou atingir um jogador. Rebelde recupera a
        bola caso passe por cima dela enquanto estiver no ch\xE3o ou encoste nela
        durante sua trajet\xF3ria."
      Icon: {fileID: 0}
      Videos:
      - {fileID: 32900000, guid: b96225ad72386e84491f230f5cdf18bd, type: 3}
    - Heading: PASSIVA
      Description: "A cada arremesso, a velocidade da bola aumenta, podendo aumentar at\xE9 2
        vezes. Ao ser pega pela 3\xAA vez, a bola volta \xE0 velocidade inicial no
        pr\xF3ximo arremesso."
      Icon: {fileID: 0}
      Videos:
      - {fileID: 32900000, guid: 057cd24abdc68a5449076a02ee5818cf, type: 3}
    - Heading: HABILIDADE
      Description: "Rebelde rebate tudo o que vier em sua dire\xE7\xE3o, direcionando os
        proj\xE9teis para onde estiver olhando no momento da rebatida. Isso se
        aplica tanto aos disparos dos inimigos quanto \xE0 sua pr\xF3pria bola, caso
        tenha sido arremessada."
      Icon: {fileID: 21300000, guid: c2f2db52242a0784c828c7b3da6c4da6, type: 3}
      Videos:
      - {fileID: 32900000, guid: 2e3873bfb0e4fcf47bb3d6b71279370d, type: 3}
